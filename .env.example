# Copia este archivo como .env y pon tus datos reales (el .env NO se sube a git)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=biblioteca
PORT=3000
SESSION_SECRET=reemplaza-por-un-secreto-aleatorio-largo
ADMIN_EMAIL=admin@biblioteca.com
ADMIN_PASSWORD=cambia-esta-clave-antes-de-usar

# --- Avisos por correo (opcional). Ejemplo con Gmail y contraseña de aplicación ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=contrasena_de_aplicacion
MAIL_FROM="Biblioteca <tucorreo@gmail.com>"
AVISO_DIAS=2
